<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RsdpCadParser</RootNamespace>
    <AssemblyName>rsdp-cad-parser</AssemblyName>
    <!-- ACadSharp 传递依赖 System.Text.Encoding.CodePages 9.x，在 net7.0 下运行正常，屏蔽 TFM 警告 -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- 测试目录独立成项目，主项目完全排除（含内容文件，防止 bin 递归复制） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.7.16" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

</Project>
